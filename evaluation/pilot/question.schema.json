{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StudyRAG pilot question record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question_id",
    "split",
    "group_id",
    "category",
    "question",
    "answerable",
    "reference_answer",
    "evidence",
    "review_status",
    "reviewer",
    "review_notes"
  ],
  "properties": {
    "question_id": {
      "type": "string",
      "pattern": "^pilot-[0-9]{3}$"
    },
    "split": {
      "enum": [
        "dev",
        "test"
      ]
    },
    "group_id": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "exact_term",
        "paraphrase",
        "typo",
        "shorthand",
        "multi_evidence",
        "unanswerable"
      ]
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answerable": {
      "type": "boolean"
    },
    "reference_answer": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "document_id",
          "start_line",
          "end_line",
          "start_char",
          "end_char",
          "quote",
          "relevance",
          "rationale"
        ],
        "properties": {
          "document_id": {
            "type": "string"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "start_char": {
            "type": "integer",
            "minimum": 0
          },
          "end_char": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "relevance": {
            "type": "integer",
            "enum": [
              0,
              1,
              2
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review_status": {
      "enum": [
        "draft",
        "ai_reviewed",
        "accepted",
        "revise",
        "rejected"
      ]
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "review_notes": {
      "type": "string"
    },
    "unanswerable_rationale": {
      "type": "string",
      "minLength": 1
    },
    "negative_search_terms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "answerable": {
            "const": false
          }
        }
      },
      "then": {
        "required": [
          "unanswerable_rationale",
          "negative_search_terms"
        ],
        "properties": {
          "evidence": {
            "maxItems": 0
          },
          "category": {
            "const": "unanswerable"
          }
        }
      },
      "else": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "relevance": {
                  "enum": [
                    1,
                    2
                  ]
                }
              },
              "required": [
                "relevance"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "review_status": {
            "enum": [
              "accepted",
              "ai_reviewed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reviewer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ]
}
